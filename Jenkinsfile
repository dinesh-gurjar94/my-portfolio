
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'GitHub repository connected!'
            }
        }

        stage('Build') {
            steps {
                echo 'Building portfolio application'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing portfolio application'
            }
        }

        stage('Success') {
            steps {
                echo 'Portfolio CI pipeline completed!'
            }
        }
    }
}
